# Phone testing on the same Wi-Fi (Windows + WSL only).
# Used by scripts/expose-dev-lan.ps1 and `yarn dev:lan`.

# Port on Windows and inside WSL. Keep both sides on this value.
LAN_PORT=3000

# Windows IPv4 the phone should open in the browser.
# Leave empty to auto-pick the first private address that is not a WSL/Hyper-V adapter.
# If auto-pick is wrong (VPN, docking station, second NIC):
#   1. On Windows, open PowerShell and run: ipconfig
#   2. Copy the IPv4 Address of "Wireless LAN adapter Wi-Fi" or your Ethernet adapter.
#   3. Ignore 127.0.0.1 and anything on "vEthernet (WSL)".
# Example: LAN_HOST=192.168.0.196
LAN_HOST=

# WSL distro name, only if this project is not in your default distro.
# List names in PowerShell: wsl -l -q
# Example: WSL_DISTRO=Ubuntu
WSL_DISTRO=
