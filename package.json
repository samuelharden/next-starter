    "next": "16.2.6",
    "radix-ui": "^1.6.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.18.0",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
